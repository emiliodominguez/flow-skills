{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "agent-skills config",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"skillsDir": {
			"type": "string",
			"description": "Directory (relative to repo root) that holds skill folders.",
			"default": "skills"
		},
		"installMode": {
			"type": "string",
			"enum": ["symlink", "copy"],
			"description": "Default install strategy for native Claude Code and Codex skill-directory targets.",
			"default": "symlink"
		},
		"defaultTargets": {
			"type": "array",
			"items": { "type": "string" },
			"description": "Targets used when --target is not passed.",
			"default": ["claude", "codex"]
		},
		"profiles": {
			"type": "object",
			"description": "Named install sets: profile name → list of skill ids installed by `install --profile <name>`.",
			"additionalProperties": {
				"type": "array",
				"items": { "type": "string" }
			}
		},
		"targets": {
			"type": "object",
			"description": "Per-target install paths and enablement.",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["enabled", "userPath", "projectPath"],
				"properties": {
					"enabled": { "type": "boolean" },
					"userPath": {
						"type": "string",
						"description": "Install path for --scope user (may use ~)."
					},
					"projectPath": {
						"type": "string",
						"description": "Install path for --scope project (relative to cwd)."
					}
				}
			}
		}
	}
}
