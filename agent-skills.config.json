{
	"$schema": "./agent-skills.schema.json",
	"skillsDir": "skills",
	"installMode": "symlink",
	"defaultTargets": ["claude", "codex"],
	"profiles": {
		"frontend": ["ed-styles", "ed-animate", "ed-prototype"],
		"review": ["ed-review", "ed-adversarial-review", "ed-simplify", "ed-refactor"],
		"core": ["ed-plan", "ed-work", "ed-test", "ed-review", "ed-commit", "ed-ship", "ed-handoff"],
		"orchestration": ["ed-plan", "ed-orchestrate", "ed-verify", "ed-repo-brief", "ed-specialize", "ed-work", "ed-review", "ed-handoff"],
		"maintenance": [
			"ed-deps",
			"ed-diagnose",
			"ed-triage",
			"ed-benchmark",
			"ed-refactor",
			"ed-simplify",
			"ed-migrate",
			"ed-git-fix",
			"ed-pr-fix",
			"ed-prune-claude-setup"
		]
	},
	"targets": {
		"claude": {
			"enabled": true,
			"userPath": "~/.claude/skills",
			"projectPath": ".claude/skills"
		},
		"cursor": {
			"enabled": true,
			"userPath": ".cursor/rules",
			"projectPath": ".cursor/rules"
		},
		"codex": {
			"enabled": true,
			"userPath": "~/.agents/skills",
			"projectPath": ".agents/skills"
		},
		"windsurf": {
			"enabled": true,
			"userPath": ".devin/rules",
			"projectPath": ".devin/rules"
		},
		"copilot": {
			"enabled": true,
			"userPath": ".github/copilot-instructions.md",
			"projectPath": ".github/copilot-instructions.md"
		},
		"zed": {
			"enabled": true,
			"userPath": ".rules",
			"projectPath": ".rules"
		},
		"aider": {
			"enabled": true,
			"userPath": "CONVENTIONS.md",
			"projectPath": "CONVENTIONS.md"
		},
		"cline": {
			"enabled": true,
			"userPath": "~/.cline/rules",
			"projectPath": ".cline/rules"
		},
		"continue": {
			"enabled": true,
			"userPath": "~/.continue/rules",
			"projectPath": ".continue/rules"
		}
	}
}
