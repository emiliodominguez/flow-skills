{
	"name": "agent-skills",
	"version": "0.1.1",
	"description": "Author agent skills once, install them into Claude Code, Cursor, Codex/AGENTS.md and Windsurf — with validation, scaffolding and a tested installer.",
	"type": "module",
	"private": true,
	"bin": {
		"agent-skills": "./dist/index.js"
	},
	"files": [
		"dist",
		"skills",
		"templates",
		"install.sh",
		"agent-skills.config.json",
		"agent-skills.schema.json"
	],
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"skills": "tsx src/index.ts",
		"build": "tsup",
		"dev": "tsx src/index.ts",
		"validate": "tsx src/index.ts validate",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "pnpm run build"
	},
	"dependencies": {
		"commander": "^12.1.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"prettier": "^3.4.2",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"keywords": [
		"claude-code",
		"agent-skills",
		"cursor",
		"codex",
		"windsurf",
		"ai-agents",
		"skills",
		"cli"
	],
	"license": "MIT"
}
