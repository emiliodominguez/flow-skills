{
	"name": "flow-skills",
	"version": "0.6.0",
	"private": true,
	"description": "Portable, agent-agnostic workflow skills for AI coding agents: plan, build, test, review, verify and ship. Install with npx skills.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/flow-skills.git"
	},
	"homepage": "https://github.com/emiliodominguez/flow-skills#readme",
	"bugs": {
		"url": "https://github.com/emiliodominguez/flow-skills/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"scripts": {
		"skills": "node --import tsx src/index.ts",
		"dev": "node --import tsx src/index.ts",
		"validate": "node --import tsx src/index.ts validate",
		"docs:gen": "node --import tsx scripts/gen-skill-docs.ts",
		"eval:llm": "node --import tsx scripts/eval-llm.ts",
		"changeset": "changeset",
		"version:packages": "changeset version && node --import tsx scripts/sync-plugin-version.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.check.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run validate && pnpm run test:coverage && pnpm run docs:check",
		"prepare": "husky",
		"docs:check": "node --import tsx scripts/gen-skill-docs.ts --check",
		"eval:prepare": "node --import tsx scripts/prepare-eval.ts",
		"smoke": "sh scripts/smoke-install.sh"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"prettier --write",
			"eslint --fix --no-warn-ignored"
		],
		"*.{json,md,yml,yaml}": "prettier --write"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"js-yaml": "^5.4.2",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^10.11.0",
		"eslint-plugin-jsdoc": "^64.5.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"keywords": [
		"agent-skills",
		"skills",
		"ai-agents",
		"coding-agents",
		"agentic-workflows",
		"developer-workflow",
		"planning",
		"code-review",
		"verification",
		"orchestration",
		"llm"
	],
	"license": "MIT"
}
